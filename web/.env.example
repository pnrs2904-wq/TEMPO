# Tempo 4.0 website + API. Empty values only; never commit real ones.
# Without the Supabase values the site runs in local-only mode (everything on the device).

# --- Public (sent to browsers) ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Same value as NEXT_PUBLIC_SITE_URL; used for CORS on the API.
SITE_ORIGIN=
SUPABASE_SERVICE_ROLE_KEY=

# Rate limits shared across server instances. Without these, limits are per instance (in memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Razorpay (web payments). Prices are fixed in src/lib/server/config.mjs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Play (Android purchases): service account with access to the Play Console,
# a 32-byte key (base64) to encrypt stored purchase tokens, and the RTDN push settings.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
PLAY_TOKEN_ENCRYPTION_KEY=
PLAY_RTDN_AUDIENCE=
PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# AI reflections (optional; also needs the ai_reflections flag on and the user's opt-in)
GEMINI_API_KEY=
GEMINI_MODEL=
AI_MONTHLY_QUOTA=60
AI_GLOBAL_DAILY_CAP=
